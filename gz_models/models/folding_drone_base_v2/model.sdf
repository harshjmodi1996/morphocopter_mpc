    </link>
    <joint name="upper_arm_joint" type="revolute">
      <parent>base_link</parent>
      <child>upper_arm</child>
      <!-- <pose>-0.15 0.15 .013 0.0 0 0.0</pose> -->
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <!-- 0/+90 deg. -->
          <lower>-0.78539816339</lower>
          <upper>0.78539816339</upper>
          <effort>1.8639</effort>
        </limit>
        
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
      <!-- <axis>
        <xyz>0 0 1</xyz>

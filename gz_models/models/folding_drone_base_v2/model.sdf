<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>

  <!-- in version 2, only changed moment of inertias and masses and propellers xy locations, rest things have been kept same as version 1-->
  
  <model name='folding_drone_base_v2'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>1.19253</mass>
        <!-- <pose>0 0 -0.0756 0 0 0</pose> June 26, 2024-->
        <pose>0.00 0.0 -0.02258 0 0 0</pose>
        <inertia>
          <ixx>0.0068</ixx>
          <ixy>-0.0041</ixy>
          <ixz>0</ixz>
          <iyy>0.0068</iyy>
          <iyz>0</iyz>
          <izz>0.0099</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name="base_link_visual">
        <!-- <pose>0.22 -0.145 .025 -1.57079632679 0 2.3561944905</pose> June 26, 2024-->   
        <pose>0.0 0.0 0 0.0 0 1.57</pose>
        <transparency>0.1</transparency>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://folding_drone_base_v2/meshes/main_assembly_2.0_bottom_half_m_donottranslate.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Black</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name="base_link_collision_0">
        <pose>0 0 0 0 0 0.78539816339</pose>
        <geometry>
          <box>
            <size>0.5 0.13 0.08</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name="base_link_collision_1">
        <pose>0.03 -0.03 -.058 -0.25 0 0.78</pose>
        <geometry>

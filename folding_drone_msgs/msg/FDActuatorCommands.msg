uint64 timestamp		# time since system start (microseconds)


bool position
bool velocity
bool acceleration
bool attitude
bool body_rate
bool thrust_and_torque
bool direct_actuator
float32 joint_angle  # upper arm joint angle in radians - used in all modes

float32[4] motor_controls  # motor 0, motor 1, motor 2, motor 3 - only used in direct_actuator mode

float32[3] trajectory_setpoint  # x,y,z  - only used in position mode
float32 yaw # - only used in position mode

float32[4] attitude_quaternions        # Quaternions in FRD frame considering joint angles - only used in attitude mode
float32 thrust_body  # normalized total thrust to be generated by motors (NED frame) - only used in attitude mode, and thrust_and_torque

float32[3] torque_setpoint


